# Futa production environment.
# Copy to /opt/futa/.env, then: chmod 600 /opt/futa/.env && chown futa:futa /opt/futa/.env
# This file must NEVER be committed. `.env` is gitignored.

# NODE_ENV is set by systemd (futa.service) — do not set it here; Vite warns.
PORT=4000
# Bind the API to localhost only; nginx is the public entry point.
HOST=127.0.0.1

# --- MongoDB -----------------------------------------------------------------
# Recommended for a 1 GB droplet: MongoDB Atlas free tier (M0).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/futa_monolith?retryWrites=true&w=majority

# ...or a MongoDB instance running on this droplet:
# MONGODB_URI=mongodb://127.0.0.1:27017/futa_monolith

# --- Optional ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API cross-origin.
# Same-origin deploys (nginx serving both the app and /api) do not need this.
# CORS_ORIGIN=https://futa.example.com
